# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Build
/build/
/_build/
*.egg-info/

# Spikes: generated environment and artefacts (regenerable)
spikes/.entorno/
spikes/spk03/pki/
spikes/spk03/out/
spikes/spk03/reportes/
spikes/spk03/dssval/lib/
spikes/spk03/dssval/libdebug/
spikes/spk03/dssval/classes/
spikes/spk03/dssval/target/

# Never commit personal or secret material
*.key
*.key.der
*.p12
*.pfx
evidencias-personales/


# Public IOFE CA certificates (override of a global *.pem ignore rule)
!spikes/ca-iofe/*.pem
!src/berigna/core/trust/anchors/*.pem

# Brand PNG exports are regenerated from the SVG sources
data/brand/*.png

# Pinned root of the INDECOPI trusted list (ADR-0014); overrides a global *.crt ignore rule
!src/berigna/core/trust/tsl/*.crt
