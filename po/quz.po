#: src/berigna/core/appearance.py:57
msgid "Digitally signed by"
msgstr "Firma digitalwan firmarqan"

#: src/berigna/core/appearance.py:58
#, python-brace-format
msgid "DNI {dni}"
msgstr "DNI {dni}"

#: src/berigna/core/appearance.py:59
#, python-brace-format
msgid "Date: {date}"
msgstr "P'unchaw: {date}"

#: src/berigna/core/appearance.py:60
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Imarayku: {reason}"

#: src/berigna/core/appearance.py:61
#, python-brace-format
msgid "Location: {location}"
msgstr "Maypi: {location}"

#: src/berigna/core/appearance.py:62
#, python-brace-format
msgid "How to verify: {url}"
msgstr "Imaynata chiqaqchana: {url}"

#: src/berigna/core/reasons.py:31
msgid "Authorship of the document"
msgstr "Qillqaq kamachiqnin"

#: src/berigna/core/reasons.py:32
msgid "In agreement"
msgstr "Allinpaq qhawarispa"

#: src/berigna/core/reasons.py:33
msgid "Endorsement (V° B°)"
msgstr "Allin qhawasqa (V° B°)"

#: src/berigna/core/reasons.py:34
msgid "Approval of the document"
msgstr "Qillqata chaskikuy"

#: src/berigna/core/reasons.py:36
msgid "On behalf of another person"
msgstr "Huk runaq kamachisqanwan"

#: src/berigna/core/report/messages.py:19
msgid "The signature is valid."
msgstr "Firmaqa chiqaqmi."

#: src/berigna/core/report/messages.py:20
msgid "The signature is not valid."
msgstr "Firmaqa manan chiqaqchu."

#: src/berigna/core/report/messages.py:21
msgid "It could not be determined whether the signature is valid."
msgstr "Manan yachakunchu firma chiqaq kasqanta."

#: src/berigna/core/report/messages.py:27
msgid "The signature is damaged or does not have the expected format."
msgstr "Firmaqa p'akisqa kashan utaq manan suyasqa hinachu."

#: src/berigna/core/report/messages.py:29
msgid "The signed content was changed after it was signed."
msgstr "Firmasqa qillqaqa firmasqa kasqanmanta qhipaman tikrasqa karqan."

#: src/berigna/core/report/messages.py:31
msgid "The signature value does not match the signer's certificate."
msgstr "Firmaq chaninqa manan firmaqpa certificadonwan tupanchu."

#: src/berigna/core/report/messages.py:34
msgid ""
"The signer's certificate had been revoked before the signature was made."
msgstr "Firmakushaqtinqa firmaqpa certificadonqa ñam anulasqaña karqan."

#: src/berigna/core/report/messages.py:37
msgid "The signature was made before the signer's certificate became valid."
msgstr "Firmaqa firmaqpa certificadon allin kanan ñawpaqtaraq ruwakurqan."

#: src/berigna/core/report/messages.py:40
msgid "The signature does not meet the requirements of the validation policy."
msgstr "Firmaqa manan chiqaqchay kamachiykunata hunt'anchu."

#: src/berigna/core/report/messages.py:43
msgid ""
"A certificate in the chain does not meet the requirements of the validation "
"policy."
msgstr "Cadenapi huk certificado manan chiqaqchay kamachiykunata hunt'anchu."

#: src/berigna/core/report/messages.py:46
msgid "The certificate chain of the signer could not be validated."
msgstr "Manan atikurqanchu firmaqpa certificadonkunaq cadenanta chiqaqchayta."

#: src/berigna/core/report/messages.py:49
msgid ""
"The signature uses an algorithm or a key size that is no longer considered "
"secure."
msgstr ""
"Firmaqa huk algoritmota utaq llave sayayta llamk'achin, kunanqa manaña "
"allinchu."

#: src/berigna/core/report/messages.py:52
msgid ""
"The signer's certificate has expired, and nothing proves that the signature "
"was made while it was valid."
msgstr ""
"Firmaqpa certificadonpa pachan tukurqan, manan imapas rikuchinchu allin "
"kashaqtin firmakusqanta."

#: src/berigna/core/report/messages.py:56
msgid ""
"The signer's certificate is not yet valid at the time of the verification."
msgstr "Firmaqpa certificadonqa chiqaqchay pachapi manaraq allinchu."

#: src/berigna/core/report/messages.py:58
msgid "The signature policy could not be processed."
msgstr "Manan atikurqanchu firma kamachiyta ruwayta."

#: src/berigna/core/report/messages.py:60
msgid "The signature policy that the signature refers to is not available."
msgstr "Firmaq rimasqan firma kamachiyqa manan kanchu."

#: src/berigna/core/report/messages.py:63
msgid "The time-stamps of the signature are not in a consistent order."
msgstr "Firmaq pacha sellonkunaqa manan allin siqipichu kashan."

#: src/berigna/core/report/messages.py:65
msgid "The signer's certificate was not found."
msgstr "Manan tarikurqanchu firmaqpa certificadonta."

#: src/berigna/core/report/messages.py:67
msgid "The signer's certificate does not lead to any trusted root certificate."
msgstr ""
"Firmaqpa certificadonqa manan ni huk iñisqa saphi certificadomanchu chayan."

#: src/berigna/core/report/messages.py:70
msgid ""
"The signer's certificate has been revoked, and nothing proves that the "
"signature was made before the revocation."
msgstr ""
"Firmaqpa certificadonqa anulasqa karqan, manan imapas rikuchinchu anulakunan "
"ñawpaqta firmakusqanta."

#: src/berigna/core/report/messages.py:74
msgid ""
"A certification authority in the chain has been revoked, and nothing proves "
"that the signature was made before the revocation."
msgstr ""
"Cadenapi huk certificación entidadqa anulasqa karqan, manan imapas "
"rikuchinchu anulakunan ñawpaqta firmakusqanta."

#: src/berigna/core/report/messages.py:78
msgid ""
"A certificate in the chain is outside its validity period, and nothing "
"proves that the signature was made while it was valid."
msgstr ""
"Cadenapi huk certificadoq pachan tukusqa, manan imapas rikuchinchu allin "
"kashaqtin firmakusqanta."

#: src/berigna/core/report/messages.py:82
msgid ""
"The revocation information is outside its validity period, and nothing "
"proves when it was obtained."
msgstr ""
"Anulasqa kasqanmanta willakuyqa pachanmanta hawapi kashan, manan imapas "
"rikuchinchu hayk'aq hap'ikusqanta."

#: src/berigna/core/report/messages.py:86
msgid ""
"The signer's certificate has expired without being revoked; a time-stamp is "
"needed to prove when the signature was made."
msgstr ""
"Firmaqpa certificadonpa pachan tukurqan mana anulasqa kaspa; pacha sellon "
"necesitakun hayk'aq firmakusqanta rikuchinapaq."

#: src/berigna/core/report/messages.py:90
msgid ""
"The signature uses an algorithm that is no longer considered secure, and "
"nothing proves that it was made while the algorithm still was."
msgstr ""
"Firmaqa manaña allin algoritmota llamk'achin, manan imapas rikuchinchu "
"allinraq kashaqtin firmakusqanta."

#: src/berigna/core/report/messages.py:93
msgid "Nothing proves that the signature existed at the required time."
msgstr "Manan imapas rikuchinchu necesitasqa pachapi firma kasqanta."

#: src/berigna/core/report/messages.py:95
msgid ""
"The revocation status of a certificate could not be checked. Try again "
"later, with an Internet connection."
msgstr ""
"Manan atikurqanchu huk certificado anulasqa kasqanta qhawariyta. Qhipata "
"internetwan wakmanta kallpachakuy."

#: src/berigna/core/report/messages.py:98
msgid "The signed data was not found."
msgstr "Manan tarikurqanchu firmasqa willakuykunata."

#: src/berigna/core/report/messages.py:99
msgid "The signature could not be validated for another reason."
msgstr "Huk imaraykurayku manan atikurqanchu firmata chiqaqchayta."

#: src/berigna/core/report/messages.py:103
msgid "The document has not been changed since it was signed."
msgstr "Qillqaqa manan tikrasqachu firmakusqanmanta."

#: src/berigna/core/report/messages.py:105
msgid ""
"After signing, only validation data and time-stamps were added; the content "
"has not changed."
msgstr ""
"Firmakusqanmanta qhipaman chiqaqchay willakuykunalla pacha sellokunallapas "
"yapakurqan; qillqaqa manan tikrasqachu."

#: src/berigna/core/report/messages.py:109
msgid ""
"After signing, form fields were filled in or other signatures were added."
msgstr ""
"Firmakusqanmanta qhipaman formulario campokuna hunt'achisqa karqan utaq huk "
"firmakuna yapakurqan."

#: src/berigna/core/report/messages.py:111
msgid "After signing, comments or annotations were added."
msgstr "Firmakusqanmanta qhipaman rimaykuna utaq willakuykuna yapakurqan."

#: src/berigna/core/report/messages.py:113
msgid ""
"The document was changed after it was signed. Open the signed version to see "
"exactly what was signed."
msgstr ""
"Qillqaqa firmakusqanmanta qhipaman tikrasqa karqan. Firmasqa kaqta kichay "
"imata firmakusqanta allinta rikunaykipaq."

#: src/berigna/core/report/messages.py:118
#, python-brace-format
msgid "Signed by {name}."
msgstr "{name} firmarqan."

#: src/berigna/core/report/messages.py:119
#, python-brace-format
msgid "The time of signing, {time}, is certified by a time-stamping authority."
msgstr ""
"Firmakusqan pacha, {time}, huk pacha sello churaq entidadpa chiqaqchasqanmi."

#: src/berigna/core/report/messages.py:121
#, python-brace-format
msgid ""
"The time of signing, {time}, was declared by the signer's computer and is "
"not certified."
msgstr ""
"Firmakusqan pacha, {time}, firmaqpa computadoranmi nirqan, manan "
"chiqaqchasqachu."

#: src/berigna/core/report/messages.py:123
#, python-brace-format
msgid "Document time-stamp issued on {time}."
msgstr "Qillqaq pacha sellon {time} p'unchawpi qusqa."

#: src/berigna/core/report/messages.py:125
msgid ""
"The chain ends in a root certificate that you added yourself, not in an "
"official one."
msgstr ""
"Cadenaqa qamkikiq yapasqayki saphi certificadopi tukukun, manan oficial "
"kaqpichu."

#: src/berigna/core/report/messages.py:129
msgid "Signature verification report"
msgstr "Firmakunaq chiqaqchay willakuynin"

#: src/berigna/core/report/messages.py:130
#: src/berigna/core/report/messages.py:230
#: src/berigna/core/report/messages.py:249
msgid "File"
msgstr "Archivo"

#: src/berigna/core/report/messages.py:131
#: src/berigna/core/report/messages.py:250
msgid "SHA-256 of the file"
msgstr "Archivoq SHA-256 nisqan"

#: src/berigna/core/report/messages.py:132
msgid "Verified on"
msgstr "Chiqaqchasqa"

#: src/berigna/core/report/messages.py:133
msgid "Trusted root certificates"
msgstr "Iñisqa saphi certificadokuna"

#: src/berigna/core/report/messages.py:134
#, python-brace-format
msgid "{count} certificates of the official PKI (IOFE)"
msgstr "Oficial infraestructuraq (IOFE) {count} certificadonkuna"

#: src/berigna/core/report/messages.py:135
#, python-brace-format
msgid "{count} certificates, including roots you added yourself"
msgstr "{count} certificadokuna, qampa yapasqayki saphikunapas"

#: src/berigna/core/report/messages.py:136
#, python-brace-format
msgid "Signature {number} of {total}: {field}"
msgstr "Firma {number} / {total}: {field}"

#: src/berigna/core/report/messages.py:137
#: src/berigna/core/report/messages.py:232
#: src/berigna/core/report/messages.py:256
msgid "Result"
msgstr "Lluqsisqan"

#: src/berigna/core/report/messages.py:138
msgid "ETSI EN 319 102-1 code"
msgstr "ETSI EN 319 102-1 código"

#: src/berigna/core/report/messages.py:139
#: src/berigna/core/report/messages.py:254
msgid "Signer"
msgstr "Firmaq"

#: src/berigna/core/report/messages.py:140
msgid "Issued by"
msgstr "Pi qusqan"

#: src/berigna/core/report/messages.py:141
msgid "Time declared by the signer"
msgstr "Firmaqpa nisqan pacha"

#: src/berigna/core/report/messages.py:142
msgid "Signature time-stamp"
msgstr "Firmaq pacha sellon"

#: src/berigna/core/report/messages.py:143
msgid "Changes after signing"
msgstr "Firmakusqanmanta qhipaman tikraykuna"

#: src/berigna/core/report/messages.py:144
msgid "Signed version"
msgstr "Firmasqa kaq"

#: src/berigna/core/report/messages.py:145
#, python-brace-format
msgid "First {length} bytes of the file"
msgstr "Archivoq ñawpaq {length} bytenkuna"

#: src/berigna/core/report/messages.py:146
msgid "None"
msgstr "Mana imapas"

#: src/berigna/core/report/messages.py:148
#, python-brace-format
msgid "{date} at {hour}h{minute} {zone}"
msgstr "{date}, {hour}h{minute} {zone}"

#: src/berigna/core/report/messages.py:149 src/berigna/ui/verification.py:200
msgid "Document time-stamps"
msgstr "Qillqaq pacha sellonkuna"

#: src/berigna/core/report/messages.py:150
msgid "This document has no signatures."
msgstr "Kay qillqaqa manan firmayuqchu."

#: src/berigna/core/report/messages.py:151
#, python-brace-format
msgid "Report generated by berigna {version}."
msgstr "berigna {version} kay willakuyta ruwarqan."

#: src/berigna/core/report/messages.py:153
msgid ""
"This report is a translation. In case of discrepancy, the Spanish (es_PE) "
"version prevails."
msgstr ""
"Kay willakuyqa t'ikrasqa. Mana tupaqtinqa kastilla simipi kaqmi (es_PE) "
"atipan."

#: src/berigna/core/report/messages.py:155
#, python-brace-format
msgid "Page {page}"
msgstr "Rapi {page}"

#: src/berigna/core/report/messages.py:159
msgid ""
"Translation not reviewed by speakers. If in doubt, the Spanish text prevails."
msgstr ""
"Rimaqkunaq mana qhawasqan t'ikrasqa. Iskayrayaspaqa kastilla simipi "
"qillqasqan atipan."

#: src/berigna/core/report/messages.py:163
msgid "Unexpected error."
msgstr "Mana suyasqa pantay."

#: src/berigna/core/report/messages.py:164
msgid "Problem with the card reader or the card."
msgstr "Lectorpi utaq tarjetapi sasachakuy."

#: src/berigna/core/report/messages.py:165
msgid "Insert your DNIe in the card reader."
msgstr "DNIeykita lectorman satiy."

#: src/berigna/core/report/messages.py:166
msgid "This card is not supported. Only the DNIe is supported."
msgstr "Kay tarjetaqa manan llamk'anchu. DNIe nisqallam chaskikun."

#: src/berigna/core/report/messages.py:167
msgid "The DNIe gave an unexpected answer. Remove it and insert it again."
msgstr "DNIeqa mana suyasqatam kutichirqan. Hurquy, hinaspa wakmanta satiy."

#: src/berigna/core/report/messages.py:168
msgid "The certificate on the card is not meant for signing."
msgstr "Tarjetapi kaq certificadoqa manan firmanapaqchu."

#: src/berigna/core/report/messages.py:169
msgid "The DNIe was removed during the operation. Nothing was signed."
msgstr "Ruwashaqtin DNIeta hurqurqanku. Manan imatapas firmakurqanchu."

#: src/berigna/core/report/messages.py:170
msgid "Another program is using the DNIe. Close it and try again."
msgstr ""
"Huk programam DNIeta llamk'achishan. Wichqay, hinaspa wakmanta kallpachakuy."

#: src/berigna/core/report/messages.py:171
msgid "The smart card service (pcscd) is not running. Install it or start it."
msgstr ""
"Tarjetakunaq servicion (pcscd) manan llamk'ashanchu. Churay utaq qallarichiy."

#: src/berigna/core/report/messages.py:172
msgid "Communication with the card failed for a moment. Try again."
msgstr "Tarjetawan rimanakuyqa huk ratulla pantarqan. Wakmanta kallpachakuy."

#: src/berigna/core/report/messages.py:174
msgid ""
"The PIN is incorrect. Check it carefully before trying again: after several "
"failed attempts the DNIe is blocked."
msgstr ""
"PINqa manan allinchu. Allinta qhawariy manaraq wakmanta churashaspa: achka "
"kuti pantaspaqa DNIeqa wichqakun."

#: src/berigna/core/report/messages.py:179
msgid ""
"The PIN is blocked. Unblock it on RENIEC's Ciudadano Digital platform or at "
"a RENIEC office."
msgstr ""
"PINqa wichqasqa kashan. RENIECpa Ciudadano Digital plataformanpi utaq "
"RENIECpa huk oficinanpi kichay."

#: src/berigna/core/report/messages.py:182
msgid "The DNIe did not accept the operation because the PIN was not verified."
msgstr "DNIeqa manan ruwayta chaskirqanchu, PIN mana chiqaqchasqa kasqanrayku."

#: src/berigna/core/report/messages.py:183
msgid "berigna refused to send a command that is not allowed to the card."
msgstr ""
"berignaqa manan munarqanchu mana saqisqa kamachiyta tarjetaman apachiyta."

#: src/berigna/core/report/messages.py:184
msgid "Problem with the trusted root certificates."
msgstr "Iñisqa saphi certificadokunapi sasachakuy."

#: src/berigna/core/report/messages.py:186
msgid ""
"The trusted root certificates installed with berigna have been altered. "
"Reinstall berigna."
msgstr ""
"berignawan churasqa iñisqa saphi certificadokunaqa tikrasqa kashan. "
"berignata wakmanta churay."

#: src/berigna/core/report/messages.py:188
msgid "A root certificate you added is not valid as a root."
msgstr "Yapasqayki huk saphi certificadoqa manan saphi hina allinchu."

#: src/berigna/core/report/messages.py:190
msgid ""
"The INDECOPI trusted list could not be used: its signature or its content is "
"not valid. The trusted root certificates installed with berigna are still "
"used."
msgstr ""
"Manan atikurqanchu INDECOPIpa iñisqa listanta llamk'achiyta: firmanpas utaq "
"ukhunpas manan allinchu. berignawan churasqa iñisqa saphi "
"certificadokunallam llamk'achikushan."

#: src/berigna/core/report/messages.py:194
msgid ""
"The INDECOPI trusted list is out of date. The trusted root certificates "
"installed with berigna are still used."
msgstr ""
"INDECOPIpa iñisqa listanqa manan kunanpaqchu. berignawan churasqa iñisqa "
"saphi certificadokunallam llamk'achikushan."

#: src/berigna/core/report/messages.py:197
msgid "Your certificate cannot be used to sign."
msgstr "Certificadoykiqa manan firmanapaq llamk'achikunmanchu."

#: src/berigna/core/report/messages.py:199
msgid ""
"Your certificate has expired or is not yet valid. DNIe certificates last "
"four years, even if the DNI is still valid; renew them on RENIEC's Ciudadano "
"Digital platform."
msgstr ""
"Certificadoykiq pachan tukurqan utaq manaraq allinchu. DNIeq "
"certificadonkunaqa tawa watalla allin, DNI allinraq kaqtinpas; RENIECpa "
"Ciudadano Digital plataformanpi musuqchakun."

#: src/berigna/core/report/messages.py:202
msgid "Your certificate has been revoked. Go to RENIEC."
msgstr "Certificadoykiqa anulasqa karqan. RENIECman riy."

#: src/berigna/core/report/messages.py:203
msgid "Your certificate does not lead to a trusted root certificate."
msgstr "Certificadoykiqa manan iñisqa saphi certificadomanchu chayan."

#: src/berigna/core/report/messages.py:204
msgid "Your certificate could not be validated."
msgstr "Manan atikurqanchu certificadoykita chiqaqchayta."

#: src/berigna/core/report/messages.py:205
msgid "The document could not be signed."
msgstr "Manan atikurqanchu qillqata firmayta."

#: src/berigna/core/report/messages.py:207
msgid ""
"The file changed after you opened it. Open it again and check it before "
"signing."
msgstr ""
"Kichasqaykimanta qhipaman archivoqa tikrarqan. Wakmanta kichay, qhawariy "
"manaraq firmashaspa."

#: src/berigna/core/report/messages.py:209
msgid "A file with that name already exists. Choose another name."
msgstr "Ñam kan chay sutiyuq archivo. Huk sutita akllay."

#: src/berigna/core/report/messages.py:210
msgid "Signing was cancelled. The PIN was not sent."
msgstr "Firmayqa saqisqa karqan. PINqa manan apachisqachu."

#: src/berigna/core/report/messages.py:211
msgid "This PDF cannot be signed: it is damaged or protected."
msgstr "Kay PDFqa manan firmakunmanchu: p'akisqa utaq amachasqa kashan."

#: src/berigna/core/report/messages.py:212
msgid ""
"The time-stamping authority did not answer. Check the connection or the TSA."
msgstr ""
"Pacha sello churaqqa manan kutichirqanchu. Tinkuyta utaq TSAta qhawariy."

#: src/berigna/core/report/messages.py:213
msgid "That signature level is not available now. Choose a lower level."
msgstr "Chay firma pataqa manan kunan kanchu. Aswan uray patata akllay."

#: src/berigna/core/report/messages.py:215
msgid ""
