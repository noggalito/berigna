msgstr "Firma {number} de {total}: {field}"

#: src/berigna/core/report/messages.py:159
#, python-brace-format
msgid "Signature {number} of {total}"
msgstr "Firma {number} de {total}"

#: src/berigna/core/report/messages.py:160
