msgstr "Informe generado por berigna {version}."

#: src/berigna/core/report/messages.py:151
msgid ""
"This report is a translation. In case of discrepancy, the Spanish (es_PE) "
"version prevails."
msgstr ""
"Este informe es una traducción. En caso de discrepancia, prevalece la "
"versión en español (es_PE)."

#: src/berigna/core/report/messages.py:153
#, python-brace-format
msgid "Page {page}"
msgstr "Página {page}"

#: src/berigna/core/report/messages.py:157
msgid ""
"Translation not reviewed by speakers. If in doubt, the Spanish text prevails."
msgstr ""
"Traducción sin revisar por hablantes. En caso de duda, prevalece el texto en "
"español."

#: src/berigna/core/report/messages.py:161
msgid "Unexpected error."
msgstr "Error inesperado."

#: src/berigna/core/report/messages.py:162
msgid "Problem with the card reader or the card."
msgstr "Problema con el lector o con la tarjeta."

#: src/berigna/core/report/messages.py:163
msgid "Insert your DNIe in the card reader."
msgstr "Inserta tu DNIe en el lector."

#: src/berigna/core/report/messages.py:164
msgid "This card is not supported. Only the DNIe is supported."
msgstr "Esta tarjeta no es compatible. Solo se admite el DNIe."

#: src/berigna/core/report/messages.py:165
msgid "The DNIe gave an unexpected answer. Remove it and insert it again."
msgstr "El DNIe dio una respuesta inesperada. Retíralo y vuelve a insertarlo."

#: src/berigna/core/report/messages.py:166
msgid "The certificate on the card is not meant for signing."
msgstr "El certificado de la tarjeta no sirve para firmar."

#: src/berigna/core/report/messages.py:167
msgid "The DNIe was removed during the operation. Nothing was signed."
msgstr "Se retiró el DNIe durante la operación. No se firmó nada."

#: src/berigna/core/report/messages.py:168
msgid "Another program is using the DNIe. Close it and try again."
msgstr "Otro programa está usando el DNIe. Ciérralo y vuelve a intentarlo."

#: src/berigna/core/report/messages.py:169
msgid "The smart card service (pcscd) is not running. Install it or start it."
msgstr ""
"El servicio de tarjetas inteligentes (pcscd) no está en funcionamiento. "
"Instálalo o inícialo."

#: src/berigna/core/report/messages.py:170
msgid "Communication with the card failed for a moment. Try again."
msgstr "La comunicación con la tarjeta falló un momento. Vuelve a intentarlo."

#: src/berigna/core/report/messages.py:172
msgid ""
"The PIN is incorrect. Check it carefully before trying again: after several "
"failed attempts the DNIe is blocked."
msgstr ""
"El PIN es incorrecto. Revísalo con cuidado antes de volver a intentarlo: "
"tras varios intentos fallidos el DNIe se bloquea."

#: src/berigna/core/report/messages.py:175
msgid "The PIN is blocked. Go to RENIEC to unblock it."
msgstr "El PIN está bloqueado. Acude a RENIEC para desbloquearlo."

#: src/berigna/core/report/messages.py:176
msgid "The DNIe did not accept the operation because the PIN was not verified."
msgstr "El DNIe no aceptó la operación porque el PIN no se verificó."

#: src/berigna/core/report/messages.py:177
msgid "berigna refused to send a command that is not allowed to the card."
msgstr "berigna se negó a enviar a la tarjeta un comando no permitido."

#: src/berigna/core/report/messages.py:178
msgid "Problem with the trusted root certificates."
msgstr "Problema con los certificados raíz de confianza."

#: src/berigna/core/report/messages.py:180
msgid ""
"The trusted root certificates installed with berigna have been altered. "
"Reinstall berigna."
msgstr ""
"Los certificados raíz de confianza instalados con berigna han sido "
"alterados. Reinstala berigna."

#: src/berigna/core/report/messages.py:182
msgid "A root certificate you added is not valid as a root."
msgstr "Un certificado raíz que añadiste no es válido como raíz."

#: src/berigna/core/report/messages.py:184
msgid ""
"The INDECOPI trusted list could not be used: its signature or its content is "
"not valid. The trusted root certificates installed with berigna are still "
"used."
msgstr ""
"No se pudo usar la lista de confianza de INDECOPI: su firma o su contenido "
"no son válidos. Se siguen usando los certificados raíz de confianza "
"instalados con berigna."

#: src/berigna/core/report/messages.py:188
msgid ""
"The INDECOPI trusted list is out of date. The trusted root certificates "
"installed with berigna are still used."
msgstr ""
"La lista de confianza de INDECOPI está desactualizada. Se siguen usando los "
"certificados raíz de confianza instalados con berigna."

#: src/berigna/core/report/messages.py:191
msgid "Your certificate cannot be used to sign."
msgstr "Tu certificado no se puede usar para firmar."

#: src/berigna/core/report/messages.py:192
msgid "Your certificate has expired or is not yet valid."
msgstr "Tu certificado venció o todavía no está vigente."

#: src/berigna/core/report/messages.py:193
msgid "Your certificate has been revoked. Go to RENIEC."
msgstr "Tu certificado fue revocado. Acude a RENIEC."

#: src/berigna/core/report/messages.py:194
msgid "Your certificate does not lead to a trusted root certificate."
msgstr "Tu certificado no lleva a un certificado raíz de confianza."

#: src/berigna/core/report/messages.py:195
msgid "Your certificate could not be validated."
msgstr "No se pudo validar tu certificado."

#: src/berigna/core/report/messages.py:196
msgid "The document could not be signed."
msgstr "No se pudo firmar el documento."

#: src/berigna/core/report/messages.py:198
msgid ""
"The file changed after you opened it. Open it again and check it before "
"signing."
msgstr ""
"El archivo cambió después de que lo abriste. Vuelve a abrirlo y revísalo "
"antes de firmar."

#: src/berigna/core/report/messages.py:200
msgid "A file with that name already exists. Choose another name."
msgstr "Ya existe un archivo con ese nombre. Elige otro nombre."

#: src/berigna/core/report/messages.py:201
msgid "Signing was cancelled. The PIN was not sent."
msgstr "Se canceló la firma. El PIN no se envió."

#: src/berigna/core/report/messages.py:202
msgid "This PDF cannot be signed: it is damaged or protected."
msgstr "Este PDF no se puede firmar: está dañado o protegido."

#: src/berigna/core/report/messages.py:203
msgid ""
"The time-stamping authority did not answer. Check the connection or the TSA."
msgstr ""
"La autoridad de sellado de tiempo no respondió. Revisa la conexión o la TSA."

#: src/berigna/core/report/messages.py:204
msgid "That signature level is not available now. Choose a lower level."
msgstr "Ese nivel de firma no está disponible ahora. Elige un nivel inferior."

#: src/berigna/core/report/messages.py:205
msgid "The document could not be verified."
msgstr "No se pudo verificar el documento."

#: src/berigna/core/report/messages.py:206
msgid "The file is not a document that berigna can read, or it is damaged."
msgstr "El archivo no es un documento que berigna pueda leer, o está dañado."

