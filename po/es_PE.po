msgstr "Emitido por"

#: src/berigna/core/report/messages.py:168
msgid "Time declared by the signer"
msgstr "Hora declarada por el firmante"

#: src/berigna/core/report/messages.py:169
msgid "Signature time-stamp"
msgstr "Sello de tiempo de la firma"

#: src/berigna/core/report/messages.py:170
msgid "Changes after signing"
msgstr "Cambios después de la firma"

#: src/berigna/core/report/messages.py:171
