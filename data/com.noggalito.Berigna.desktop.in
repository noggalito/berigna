[Desktop Entry]
Name=berigna
GenericName=Document Signer
Comment=Sign and verify documents with the Peruvian DNIe
Keywords=sign;signature;verify;PDF;XML;CAdES;XAdES;DNIe;RENIEC;
Exec=berigna %F
Icon=com.noggalito.Berigna
Terminal=false
Type=Application
Categories=Office;GTK;
MimeType=application/pdf;application/pkcs7-signature;application/pkcs7-mime;
StartupNotify=true
