#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 noggalito

%:
	dh $@ --with python3 --buildsystem=pybuild

# The sdist does not include the test suite (running it needs extras that
# Debian does not ship, such as certomancer): berigna runs its own suite
# against this package in its CI (R-DES-08).
override_dh_auto_test:
	@true

# dh_installman is not part of the default sequence: install the man page for
# the CLI alongside the docs.
override_dh_installdocs:
	dh_installdocs
	dh_installman
